# ローカル開発時に /api を転送する先。本番ビルドでは不要
# - Floci + task local:api で backend をローカルに立てる場合(README の「ローカルで画面を動かす」)
# VITE_DEV_API_PROXY=http://localhost:8080
# - dev 環境の API を使う場合は CloudFront の公開 URL
# VITE_DEV_API_PROXY=https://dev.snap-kakeibo.shrimptail.net
# CloudFront 配信時は VITE_API_BASE_URL を設定せず、同一 origin の /api/* を呼ぶ
