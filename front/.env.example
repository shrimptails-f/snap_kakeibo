# ローカル開発時に /api を転送する先。本番ビルドでは不要
# - Floci + task local:api で backend をローカルに立てる場合(README の「ローカルで画面を動かす」)
VITE_DEV_API_PROXY=http://localhost:8080
# - dev 環境の API をそのまま使う場合は CloudFront の URL
# VITE_DEV_API_PROXY=https://xxxxxxxxxxxxxx.cloudfront.net
# API の origin。未設定なら同一 origin の /api/* を呼ぶ(CloudFront 配信時はこのままでよい)
# VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com
